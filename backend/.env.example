# Copy this file to .env (same folder) and fill in your keys.
#   cp .env.example .env
# Never commit .env — it is gitignored. On Vercel, set these under
# Project → Settings → Environment Variables, then redeploy.
#
# Every source is optional: a source with no key is simply skipped.
# You need at least ONE key for search to work.

# SerpAPI — https://serpapi.com/manage-api-key
# Free plan: 250 searches/month, refills monthly.
SERPAPI_KEY=

# Serper.dev — https://serper.dev/api-key
# 2,500 free searches on signup, then ~$1 per 1,000.
SERPER_API_KEY=

# SearchAPI — https://www.searchapi.io/api_tokens
# Free credits only (no refill). When it runs out it is auto-skipped;
# delete this key to retire it completely.
SEARCHAPI_KEY=
