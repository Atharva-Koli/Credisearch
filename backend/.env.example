# Copy this file to .env (same folder) and fill in your keys.
#   cp .env.example .env
# Never commit .env — it is gitignored. On Vercel, set these under
# Project → Settings → Environment Variables, then redeploy.
#
# Every source is optional: a source with no key is simply skipped.
# You need at least ONE key for search to work.

# SerpAPI — https://serpapi.com/manage-api-key
# Free plan: 250 searches/month, refills monthly.
SERPAPI_KEY=

# Serper.dev — https://serper.dev/api-key
# 2,500 free searches on signup, then ~$1 per 1,000.
SERPER_API_KEY=

# SearchAPI — https://www.searchapi.io/api_tokens
# Free credits only (no refill). When it runs out it is auto-skipped;
# delete this key to retire it completely.
SEARCHAPI_KEY=

# ---------------- Price history (optional) ----------------
# Upstash Redis (free tier). Easiest: Vercel → Storage → Upstash Redis →
# connect to this project; Vercel then adds KV_REST_API_URL / KV_REST_API_TOKEN
# automatically. Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Protects /cron/log-prices so only Vercel Cron can trigger it (any random string).
CRON_SECRET=

# Products the daily cron searches (comma-separated). Leave empty for the defaults.
TRACKED_PRODUCTS=

# Password for editing the tracked-products list from the "Price tracker" tab
# (adding/stopping products). Pick something you'll remember. Without it the
# tracker is read-only.
ADMIN_TOKEN=
